# Proveedor del modelo. Vacío = el chat queda deshabilitado, pero demo.ts funciona igual.
ANTHROPIC_API_KEY=
MODELO=claude-haiku-5-5
TIMEOUT_LLM_MS=30000

# Servidor
PORT=3000
# Fecha de referencia del lote (YYYY-MM-DD). Vacío = fecha actual del servidor.
HOY=

# Límites de costo
MAX_ITERACIONES=25
TOKENS_MAX_SESION=200000
# Tope global del servicio (no se reinicia por sesión). Obligatorio en producción.
TOKENS_MAX_GLOBAL=2000000

# Clave opcional para proteger el chat en un link público. Vacío = sin clave.
ACCESO_CLAVE=

# Solo para Caddy (HTTPS automático en el VPS). Debe apuntar a tu dominio.
DOMINIO=localhost
